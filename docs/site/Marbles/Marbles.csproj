<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- Browser host: real Trill (row mode) under .NET WASM. build.sh copies the
       published _framework/ next to the widget script in the built book. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- partial: trim only framework assemblies marked trimmable. Trill builds
         generic types by reflection and stays whole. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Catalog/Catalog.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Row mode never invokes Roslyn, so it is never requested. Lazy-loading it
         keeps it out of the browser download (3.3 MB instead of about 11 MB). -->
    <BlazorWebAssemblyLazyLoad Include="Microsoft.CodeAnalysis.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Microsoft.CodeAnalysis.CSharp.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Microsoft.CodeAnalysis.Scripting.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Microsoft.CodeAnalysis.CSharp.Scripting.wasm" />
  </ItemGroup>
</Project>
